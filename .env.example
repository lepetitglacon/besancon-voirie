# Base PostgreSQL + PostGIS + pgRouting (docker compose)
POSTGRES_USER=voirie
POSTGRES_PASSWORD=voirie
POSTGRES_DB=voirie
POSTGRES_PORT=5433

# Base de développement (dans un worktree WTM, réécrite par `pnpm db:prepare`)
DATABASE_URL=postgres://voirie:voirie@localhost:5433/voirie

# Ports (dans un worktree WTM, fournis par le manager)
API_PORT=3000
WEB_PORT=5173

# Tests d'intégration de l'API (base créée par `pnpm db:prepare`)
DATABASE_URL_TEST=postgres://voirie:voirie@localhost:5433/voirie_test

# Composition des carrefours depuis la carte (développement local uniquement,
# en attendant l'authentification admin)
EDITION_LOCALE=true

# Open data Ginko (temps réel tram). Clé à demander à ginko.support-ssi@keolis.com
GINKO_API_KEY=

# Collecte continue des passages tram en base (historique des tronçons, calibration)
TRAM_COLLECTE=true

# Proposition « OSM + IA » des branches : Claude Code lancé sur le serveur (`claude -p`),
# installé et connecté. Modèle ou alias, délai maximal, et conservation de la photo envoyée.
IA_CLAUDE_CMD=claude
IA_MODELE=opus
# Analyses lancées en même temps par la file d'attente (0 : aucune)
IA_PARALLELE=2
IA_DELAI_S=300
IA_GARDER_FICHIERS=false
